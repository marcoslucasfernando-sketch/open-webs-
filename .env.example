# ─────────────────────────── Plataforma ───────────────────────────
PORT=3000
PUBLIC_URL=http://localhost:3000        # URL pública del panel (vistas previas, demos, OAuth, bajas)
DATA_DIR=data
PANEL_TOKEN=                             # recomendado en producción: protege la API y el panel
SECRET_KEY=                              # cifra en disco los tokens OAuth (AES-256-GCM) y firma los enlaces de baja

# ─────────────────────────── IA: GPT-6 Luna ───────────────────────────
# Formato proveedor:modelo. Cada rol puede usar un modelo distinto.
AI_RESEARCH=openai:gpt-6-luna
AI_GENERATION=openai:gpt-6-luna
OPENAI_BASE_URL=https://api.openai.com/v1   # o tu endpoint (Azure OpenAI, gateway corporativo…)
OPENAI_API_VERSION=                          # solo Azure OpenAI (p. ej. 2025-04-01-preview)
LLM_AUTH=oauth                               # oauth | apikey
OPENAI_API_KEY=                              # solo si LLM_AUTH=apikey
LLM_VISION=true                              # enviar capturas/fotos al modelo
# LLM_TEMPERATURE=0.7

# OAuth 2.0 del proveedor de IA
OAUTH_GRANT=client_credentials               # client_credentials (servidor) | authorization_code (conectar cuenta en el panel)
OAUTH_TOKEN_URL=                             # p. ej. Azure Entra ID: https://login.microsoftonline.com/<tenant>/oauth2/v2.0/token
OAUTH_AUTHORIZE_URL=                         # solo authorization_code
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_CLIENT_AUTH=post                       # post | basic
OAUTH_SCOPE=                                 # p. ej. Azure: https://cognitiveservices.azure.com/.default
OAUTH_AUDIENCE=
# OAUTH_REDIRECT_URI=http://localhost:3000/auth/llm/callback

# Skills de GPT-6 Luna
SKILLS_MODE=hybrid                           # hybrid | inject | tools
SKILLS_MAX_CHARS=60000

# ─────────────────────────── Herramientas MCP ───────────────────────────
MCP_PLAYWRIGHT=on
MCP_CHROME_DEVTOOLS=on
MCP_FIGMA=on                                 # se activa al conectar Figma en el panel (/auth/figma/start)
# PLAYWRIGHT_MCP_VERSION=0.0.82
# CHROME_DEVTOOLS_MCP_VERSION=1.10.1
# CHROMIUM_PATH=/ruta/a/chrome               # opcional: navegador ya instalado
# BROWSER_PROXY= / BROWSER_IGNORE_HTTPS_ERRORS=  # solo entornos con proxy que intercepta TLS

# ─────────────────────────── Investigación ───────────────────────────
SEARCH_PROVIDER=brave                        # brave | serpapi | tavily | fixture (demo)
BRAVE_API_KEY=
SERPAPI_KEY=
TAVILY_API_KEY=
MIN_REFERENCES=10                            # referencias por sector
MAX_CANDIDATES=30
SECTOR_CACHE_DAYS=30                         # reutilizar el master prompt del sector
RESPECT_ROBOTS=true

# ─────────────────────────── Despliegue ───────────────────────────
HOSTING_PROVIDER=netlify                     # netlify | local
NETLIFY_AUTH_TOKEN=
NETLIFY_ACCOUNT_SLUG=
DNS_PROVIDER=manual                          # cloudflare | netlify | manual
CLOUDFLARE_API_TOKEN=                        # permisos: Zone.DNS:Edit
VERIFY_TIMEOUT_MS=1800000
VERIFY_INTERVAL_MS=20000

# ─────────────────────────── Prospección (mapa Gran Canaria) ───────────────────────────
PLACES_PROVIDER=overpass                     # overpass (OpenStreetMap) | fixture (demo)
LEADS_REGION=Gran Canaria
LEADS_BBOX=27.73,-15.84,28.19,-15.35         # sur,oeste,norte,este
DEMO_HOSTING=platform                        # platform (/demo/<id>/) | netlify
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION=&copy; colaboradores de OpenStreetMap

# ─────────────────────────── Email ───────────────────────────
MAIL_DRY_RUN=true                            # true: NO envía, guarda .eml en data/outbox
MAIL_PROVIDER=smtp                           # smtp | resend
SMTP_URL=                                    # smtps://usuario:clave@smtp.tudominio.com:465
RESEND_API_KEY=
MAIL_FROM=Tu Nombre <hola@tudominio.com>
MAIL_REPLY_TO=
SENDER_NAME=Tu nombre
SENDER_COMPANY=Tu empresa
SENDER_ADDRESS=Calle, número, CP, municipio  # obligatorio para enviar (identificación del remitente)
MAIL_DAILY_LIMIT=50
MAIL_MIN_INTERVAL_MS=30000
